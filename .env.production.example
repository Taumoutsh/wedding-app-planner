# Wedding Planner App - Production Environment Variables
# Copy this file to .env in your deployment directory and update the values

# Node environment
NODE_ENV=production

# Server port (internal, used by Docker container)
PORT=6001

# Database URL
# For production with SQLite, use the persistent volume mount
DATABASE_URL=file:./prisma/prod.db

# JWT Secret - CHANGE THIS TO A STRONG RANDOM VALUE
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-strong-random-value-in-production

# Optional: Logging level
LOG_LEVEL=info

# Optional: Enable/disable certain features
ENABLE_REGISTRATION=false
